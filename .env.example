# Copy to .env (gitignored). Read by backend/app/config.py.
# Free key from https://et.water.ca.gov. Only needed for scripts/fetch_cimis.py (B) and the Render deploy (A).
CIMIS_KEY=
# 1 = serve committed snapshots instead of calling Open-Meteo (judging fallback).
DEMO_MODE=0
# Comma-separated origins allowed by CORS. Add the Vercel URL in production.
ALLOWED_ORIGINS=http://localhost:5173
# Text-message access (/api/sms). Twilio auth token: when set, requests must carry a valid signature.
TWILIO_AUTH_TOKEN=
# Only if signature checks fail behind a proxy: the exact webhook URL configured in Twilio.
SMS_WEBHOOK_URL=
# Telegram bot (/api/telegram). Token from @BotFather; never commit it.
TELEGRAM_BOT_TOKEN=
