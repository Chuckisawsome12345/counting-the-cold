# Copy to .env (gitignored) and fill in only what you need. Read by backend/app/config.py.
# Every value here is optional for running the app locally. Leave secrets empty unless you use them:
# a non-empty token turns its feature on (for example, Twilio signature checks).

# Origins allowed by CORS, comma-separated. Set to the frontend URL in production.
ALLOWED_ORIGINS=http://localhost:5173

# 1 = serve the committed snapshots of the demo pins instead of calling Open-Meteo (works offline).
DEMO_MODE=0

# CIMIS API key (free from https://et.water.ca.gov). Only scripts/fetch_cimis.py uses it.
# Format: a UUID, e.g. 00000000-0000-0000-0000-000000000000
CIMIS_KEY=

# Telegram bot token from @BotFather. Only needed to run the Telegram bot.
# Format: 123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=
# Optional: override the webhook URL /api/telegram/setup registers.
TELEGRAM_WEBHOOK_URL=

# Twilio auth token for /api/sms. When set, requests must carry a valid Twilio signature.
TWILIO_AUTH_TOKEN=
# Optional: the exact webhook URL configured in Twilio, if signature checks fail behind a proxy.
SMS_WEBHOOK_URL=

# Where bot replies link to for charts.
FRONTEND_URL=https://counting-the-cold-jfm3.vercel.app

# Optional: where the HTTP cache lives (defaults to backend/.cache, or /tmp on Vercel).
CACHE_DIR=
